rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated()
        && request.auth.token.email != null
        && (
          request.auth.token.email.matches('^.*@(company\\.com)$')
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    function isAdminOrManager() {
      return isAdmin()
        || (
          isAuthenticated()
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['hr_manager', 'team_lead']
        );
    }

    function isOwner(userIdField) {
      return isAuthenticated()
        && resource.data[userIdField] == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAdminOrManager();
      allow update: if isAdminOrManager() || isOwner('uid');
      allow delete: if isAdmin();
    }

    match /attendance/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /leave-requests/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdminOrManager();
      allow delete: if isAdmin();
    }

    match /tasks/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /holidays/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /audit_logs/{docId} {
      allow read: if isAdminOrManager();
      allow create: if isAuthenticated();
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isOwner('userId');
      allow delete: if isOwner('userId');
    }

    match /mail/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
